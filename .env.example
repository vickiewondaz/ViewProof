# Neon (pooled + direct). Get from Neon console; never commit real values.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email OTP (owners) via Resend. Dev works without keys (logs to console).
# Production: verify a domain in Resend, set EMAIL_FROM to it.
RESEND_API_KEY="change-me"
EMAIL_FROM="ViewProof <login@viewproof.app>"

# Guided support AI (optional, free tiers). Rules answer first; AI warms the words.
# Gemini: aistudio.google.com → Get API Key (no card). OpenRouter: openrouter.ai/keys.
GEMINI_API_KEY="change-me"
OPENROUTER_API_KEY="change-me"
# Optional overrides:
# AI_GUIDE_GEMINI_MODEL="gemini-3.8-flash"
# AI_GUIDE_OPENROUTER_MODEL="liquid/lfm-2.5-2.6b:free"  (free roster rotates; check openrouter.ai/models)

# Landlord's office: comma-separated emails allowed into /admin + admin APIs.
# First admin login can also be granted via: npx auth create-admin --email you@... --role admin
ADMIN_EMAILS="you@example.com"

# Public site URL used in WhatsApp links (agent confirm, receipts, nudges).
SITE_URL="https://viewproof.netlify.app"

# WhatsApp Cloud API (free tier)
WHATSAPP_TOKEN="change-me"
PHONE_NUMBER_ID="change-me"
WHATSAPP_VERIFY_TOKEN="change-me"
# Authentication-type template for agent login codes (approved in Meta).
WHATSAPP_AUTH_TEMPLATE="agent_login_code"
# Signs inbound webhooks (Meta dashboard → app → WhatsApp → Configuration).
# When set, forged CANCEL posts are rejected with 401.
WHATSAPP_APP_SECRET="change-me"

# Web Push (PWA) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"

# Shared rate limits at scale (optional; memory fallback otherwise).
# Upstash Redis → REST API → copy both values. Free tier suffices for pilot.
# UPSTASH_REDIS_REST_URL="https://...upstash.io"
# UPSTASH_REDIS_REST_TOKEN="change-me"

# Cron jobs (stale-sweep, reminders, weekly-report). Netlify scheduled
# functions read this. Generate a real value (openssl rand -hex 32).
# While unset the job endpoints fail closed (401), so never ship a literal
# placeholder — an unset secret is safer than a guessable one.
# CRON_SECRET=""

# Public URL of this site (cron functions call it; Netlify also injects URL).
# SITE_URL="https://viewproof.netlify.app"
