# Neon (pooled + direct). Get from Neon console; never commit real values.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email OTP (owners) via Resend. Dev works without keys (logs to console).
# Production: verify a domain in Resend, set EMAIL_FROM to it.
RESEND_API_KEY="change-me"
EMAIL_FROM="ViewProof <login@viewproof.app>"

# WhatsApp Cloud API (free tier)
WHATSAPP_TOKEN="change-me"
PHONE_NUMBER_ID="change-me"
WHATSAPP_VERIFY_TOKEN="change-me"

# Web Push (PWA) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"

# Cron jobs (stale sweeper)
CRON_SECRET="change-me"
