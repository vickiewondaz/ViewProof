{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Glass System Tokens",
  "description": "Platform-agnostic glassmorphism tokens. Maps to CSS variables (Web), SwiftUI Material levels (iOS), and Compose Modifier values (Android).",
  "mode": ["light", "dark"],
  "color": {
    "background": {
      "canvasLight": "#eef1fb",
      "canvasDark": "#0b1020",
      "blobA": "#5b6cff",
      "blobB": "#18c5b4",
      "blobC": "#ff8a3d",
      "blobD": "#e0447a"
    },
    "text": {
      "onGlassLight": "#0b1020",
      "mutedLight": "rgba(11,16,32,0.62)",
      "onGlassDark": "#ffffff",
      "mutedDark": "rgba(255,255,255,0.72)"
    },
    "accent": {
      "primary": "#5b6cff",
      "success": "#1e9e52",
      "warning": "#e0a008",
      "danger": "#d63a3a"
    }
  },
  "glass": {
    "blur": { "sm": 10, "md": 18, "lg": 28 },
    "saturation": { "light": 1.4, "dark": 1.6 },
    "fill": {
      "light": "rgba(255,255,255,0.55)",
      "dark": "rgba(17,22,46,0.42)"
    },
    "fillStrong": {
      "light": "rgba(255,255,255,0.72)",
      "dark": "rgba(17,22,46,0.60)"
    },
    "border": {
      "light": "rgba(255,255,255,0.70)",
      "dark": "rgba(255,255,255,0.16)"
    },
    "highlight": "rgba(255,255,255,0.35)",
    "shadow": "0 8px 32px rgba(8,12,32,0.20)",
    "shadowRaised": "0 18px 50px rgba(8,12,32,0.32)"
  },
  "radius": { "sm": 12, "md": 18, "lg": 26, "pill": 999 },
  "spacing": { "xs": 6, "sm": 10, "md": 16, "lg": 24, "xl": 32 },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "accessibility": {
    "reduceTransparencyFallbackLight": "rgba(255,255,255,0.94)",
    "reduceTransparencyFallbackDark": "rgba(20,25,50,0.96)",
    "minContrastText": 4.5,
    "minContrastLarge": 3.0
  }
}
